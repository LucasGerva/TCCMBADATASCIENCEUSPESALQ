pnad_df = pnad_db.rename(columns={'V2007': 'Genero', 'V2010':'Cor/Raça', 'VD4011' : 'Tipo de Cargo', 'V2003' : 'N° da Ordem', 'V1014': 'Painel', 'V1008' : 'N° de selecao' })

#%% Limpeza

print(pnad_df['Tipo de Cargo'].isna().sum())
print(pnad_df['Genero'].isna().sum())
print(pnad_df['Cor/Raça'].isna().sum())

pnad_df['V1028'] = pd.to_numeric(pnad_df['V1028'], errors='coerce')

# Conferir com o total de ocupados divulgado pelo IBGE (antes dos filtros)
print(f"Ocupados estimados (antes dos filtros): {pnad_df.loc[pnad_df['Tipo de Cargo'].notna(), 'V1028'].sum() / 1000:,.0f} mil pessoas")
print(' ')

# Mesmos filtros da ACM (Tipo de Cargo vazio = pessoa não ocupada)
pnad_df = pnad_df[pnad_df['Tipo de Cargo'].notna()]
pnad_df = pnad_df[pnad_df['Genero'].notna()]
pnad_df = pnad_df[pnad_df['Cor/Raça'].notna()]
pnad_df = pnad_df[pnad_df['V1028'].notna()]

pnad_df['Tipo de Cargo'] = pnad_df['Tipo de Cargo'].astype(int)

# Rótulos conforme o Dicionário da PNAD
pnad_df['Tipo de Cargo'] = pnad_df['Tipo de Cargo'].replace({
    1:'Direção',
    2:'Intelectuais',
    3:'Técnicos',
    4:'Administrativo',
    5:'Serviços/Vendas',
    6:'Agro/Pesca',
    7:'Operários',
    8:'Operadores',
    9:'Elementares',
    10:'Militares',
    11:'Indefinidas'
})
pnad_df = pnad_df[pnad_df['Tipo de Cargo'] != 'Indefinidas']

pnad_df['Genero'] = pnad_df['Genero'].replace({
    1:'Homem',
    2:'Mulher'
})

# Cor/Raça não entra na ANACOR, mas é filtrada para manter a mesma base da ACM
pnad_df['Cor/Raça'] = pnad_df['Cor/Raça'].replace({
    1:'Branca',
    2:'Preta',
    3:'Amarela',
    4 :'Parda',
    5:'Indígena',
    9:'Ignorado'
})
pnad_df = pnad_df[pnad_df['Cor/Raça'] != 'Ignorado']

#%% Descritivas

# Tamanho da amostra (registros, sem ponderação)
print(pnad_df['Tipo de Cargo'].count())
print(pnad_df['Genero'].count())

# Estimativas populacionais (soma dos pesos V1028)
print('Estimativas populacionais (ponderadas por V1028)')
print(' ')
print(pnad_df.groupby('Genero')['V1028'].sum().round(0))
print(' ')
print(pnad_df.groupby('Tipo de Cargo')['V1028'].sum().round(0).sort_values(ascending=False))
print(' ')

print(f"Ocupados estimados (após os filtros): {pnad_df['V1028'].sum() / 1000:,.0f} mil pessoas")
print(' ')

#%% Tabela de contingência ponderada (população estimada)

tabela = pd.crosstab(pnad_df["Genero"], pnad_df["Tipo de Cargo"],
                     values=pnad_df['V1028'], aggfunc='sum').fillna(0)
print(' ')

print('Tabela de contingência – população estimada (mil pessoas)')
print(' ')
print((tabela / 1000).round(0))
print(' ')

print('Distribuição percentual por gênero (%)')
print((tabela.div(tabela.sum(axis=1), axis=0) * 100).round(1))
print(' ')

#%% Significância (Rao-Scott) e intensidade da associação (V de Cramér)

rs = rao_scott(pnad_df, 'Genero', 'Tipo de Cargo', desenho)
imprimir_rao_scott(rs, 'Associação Gênero x Tipo de Cargo')
print(' ')

# V de Cramér: 0 = sem associação, 1 = associação perfeita (não depende da escala dos pesos)
def cramers_v(tabela):
    qui2, p, gl, esperados = chi2_contingency(tabela)
    n = tabela.to_numpy().sum()
    r, k = tabela.shape
    v = np.sqrt(qui2 / (n * min(r - 1, k - 1)))
    return v

print(f"V de Cramér: {cramers_v(tabela):.4f}")
print(' ')

#%% Frequências esperadas e resíduos

tab_cont = sm.stats.Table(tabela)

# Frequências esperadas sob independência (população estimada)
print('Tabela frequências absolutas esperadas')
print(tab_cont.fittedvalues)
print(' ')

# Observado - esperado (população estimada)
print('Tabela de resíduos: diferença entre freq. absolutas observadas e esperadas')
print(tabela - tab_cont.fittedvalues)
print(' ')

# Valores abaixo vêm da função rao_scott (corrigidos pelo plano amostral)
print('Tabela de valores qui-quadrado por célula (Rao-Scott)')
print(rs['contrib'])
print(' ')

print('Tabela de Resíduos padronizados (Rao-Scott)')
print(rs['resid_pearson'])
print(' ')

print('Tabela de Resíduos padronizados ajustados (plano amostral)')
print(rs['resid_ajust'])
print(' ')

#%% Mapa de calor dos resíduos ajustados
# Vermelho = mais ocorrências que o esperado; azul = menos.
# resíduo > 1,96 indica associação significativa a 5%.

print('Mapa de calor dos resíduos padronizados ajustados')
residuos_ajustados = rs['resid_ajust']

# Escala simétrica em torno de zero
limite = np.max(np.abs(residuos_ajustados.to_numpy()))
limite = np.ceil(limite * 10) / 10

fig = go.Figure()
fig.add_trace(
    go.Heatmap(
        x = residuos_ajustados.columns,
        y = residuos_ajustados.index,
        z = residuos_ajustados.values,
        text = residuos_ajustados.values,
        texttemplate = '%{text:.2f}',
        colorscale = [
            [0.00, 'skyblue'],
            [0.50, '#FAF9F6'],
            [1.00, 'lightcoral']
        ],
        zmin = -limite,
        zmax = limite,
        colorbar = dict(title='Resíduo')))

fig.update_layout(
    title_text = 'Gênero × Tipo de Cargo — Resíduos Padronizados Ajustados',
    title_x = 0.5,
    height = 600,
    width = 700)

# Rótulos inclinados quando há muitas categorias
fig.update_xaxes(
    categoryorder = 'category ascending',
    tickangle = -45 if len(residuos_ajustados.columns) > 6 else 0,
    automargin = True)
fig.update_yaxes(categoryorder = 'category descending')

fig.show()
print(' ')

#%% ANACOR (sobre a tabela ponderada)

ca = prince.CA().fit(tabela)

# Autovalores: são gerados mín(I-1, J-1) — com 2 gêneros, apenas 1 dimensão
tabela_autovalores = ca.eigenvalues_summary
print(tabela_autovalores)

# Inércia total = soma dos autovalores = qui² / N
# Quanto maior, mais forte a associação entre as categorias
print(ca.total_inertia_)

# Massas (peso relativo de cada categoria)
print(ca.row_masses_)
print(ca.col_masses_)

# Autovetores (linha e coluna)
print(ca.svd_.U)
print(ca.svd_.V.T)

# Coordenadas do mapa perceptual (linha = Gênero, coluna = Tipo de Cargo)
print(ca.row_coordinates(tabela))
print(ca.column_coordinates(tabela))

#%% Mapa perceptual
# Com uma única dimensão, o eixo Y não tem significado estatístico: os pontos são
# apenas distribuídos em alturas diferentes (zigue-zague) para os rótulos não se
# sobreporem. A leitura deve ser feita só no eixo X.

num_dims = ca.row_coordinates(tabela).shape[1]

if num_dims > 1:
    y_row_vals = ca.row_coordinates(tabela)[1].values
    y_col_vals = ca.column_coordinates(tabela)[1].values
else:
    # Gêneros em cima; cargos embaixo, alternando em 4 níveis
    y_row_vals = np.full(tabela.shape[0], 0.1)
    niveis_y = [-0.05, -0.15, -0.25, -0.35]
    y_col_vals = np.array([niveis_y[i % 4] for i in range(tabela.shape[1])])

chart_df_row = pd.DataFrame({
    'var_row': tabela.index,
    'x_row': ca.row_coordinates(tabela)[0].values,
    'y_row': y_row_vals
})

chart_df_col = pd.DataFrame({
    'var_col': tabela.columns,
    'x_col': ca.column_coordinates(tabela)[0].values,
    'y_col': y_col_vals
})

dim1_label = f"Dim. 1: {tabela_autovalores.iloc[0,1]} da inércia"
dim2_label = f"Dim. 2: {tabela_autovalores.iloc[1,1]} da inércia" if num_dims > 1 else "Dim. 2: Inexistente (Separação Artificial)"

plt.figure(dpi=600, figsize=(10, 6))
ax = plt.gca()

# Fundo transparente e sem grade
fig = plt.gcf()
fig.patch.set_facecolor('none')
ax.set_facecolor('none')
ax.grid(False)

sns.scatterplot(data=chart_df_row, x='x_row', y='y_row', s=50, alpha=0.7, color='navy', label='Gênero')
sns.scatterplot(data=chart_df_col, x='x_col', y='y_col', s=50, alpha=0.7, color='darkorange', label='Tipo de Cargo')

texts = []
for i, point in chart_df_row.iterrows():
    texts.append(plt.text(point['x_row'], point['y_row'], point['var_row'], fontsize=8, color='navy'))
for i, point in chart_df_col.iterrows():
    texts.append(plt.text(point['x_col'], point['y_col'], point['var_col'], fontsize=8, color='darkorange'))

# Evita sobreposição dos rótulos
adjust_text(texts, force_text=(0.5, 1.0), arrowprops=dict(arrowstyle="-", color='gray', lw=0.5))

# Apenas eixos inferior e esquerdo, pretos e sólidos
sns.despine(top=True, right=True, left=False, bottom=False)
for lado in ['bottom', 'left']:
    ax.spines[lado].set_color('black')
    ax.spines[lado].set_linewidth(1.5)
    ax.spines[lado].set_linestyle('-')

# Espaço extra no eixo Y para o zigue-zague
if num_dims == 1:
    plt.ylim(-0.45, 0.25)

plt.tick_params(size=2, labelsize=6)

font_axes = {'family': 'Arial', 'size': 11, 'color': 'black'}
plt.xlabel(dim1_label, fontdict=font_axes)
plt.ylabel(dim2_label, fontdict=font_axes)

plt.title('')
plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left', borderaxespad=0., fontsize=8)

plt.tight_layout()
plt.show()
