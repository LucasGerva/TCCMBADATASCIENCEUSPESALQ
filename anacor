#%% Teste qui² com correção de Rao-Scott

def rao_scott(df, var_linha, var_coluna, desenho, peso='V1028', estrato='Estrato', upa='UPA'):

    linhas = sorted(df[var_linha].unique())
    colunas = sorted(df[var_coluna].unique())
    r, c = len(linhas), len(colunas)
    m = r * c

    li = df[var_linha].map({v: i for i, v in enumerate(linhas)}).to_numpy()
    ci = df[var_coluna].map({v: j for j, v in enumerate(colunas)}).to_numpy()
    cel = li * c + ci

    w = df[peso].to_numpy(dtype=float)
    n = len(df)
    W = w.sum()

    # Proporções ponderadas observadas (P) e esperadas sob independência (E)
    p = np.bincount(cel, weights=w, minlength=m) / W
    P = p.reshape(r, c)
    p_lin = P.sum(axis=1)
    p_col = P.sum(axis=0)
    E = np.outer(p_lin, p_col)

    qui2 = n * ((P - E) ** 2 / E).sum()
    gl = (r - 1) * (c - 1)

    # Covariância das proporções pelo plano amostral (linearização por UPA dentro do estrato)
    aux = pd.DataFrame({estrato: df[estrato].to_numpy(), upa: df[upa].to_numpy(), 'cel': cel, 'w': w})
    T = (aux.groupby([estrato, upa, 'cel'])['w'].sum()
            .unstack(fill_value=0)
            .reindex(columns=range(m), fill_value=0))
    Z = (T.to_numpy() - T.to_numpy().sum(axis=1, keepdims=True) * p) / W
    Z = pd.DataFrame(Z, index=T.index)

    # UPAs sem ninguém do domínio entram com zero
    upas = desenho[[estrato, upa]].drop_duplicates()
    Z = Z.reindex(pd.MultiIndex.from_frame(upas), fill_value=0)

    h = pd.Series(Z.index.get_level_values(0))
    nh = h.map(h.value_counts()).to_numpy()
    Zc = (Z - Z.groupby(level=0).transform('mean')).to_numpy()
    Zc = Zc * np.sqrt(np.where(nh > 1, nh / (nh - 1), 0))[:, None]
    V = Zc.T @ Zc

    # Contrastes que representam a hipótese de independência
    M_lin = np.kron(np.eye(r), np.ones((c, 1)))
    M_col = np.kron(np.ones((r, 1)), np.eye(c))
    X1 = np.column_stack([np.ones(m), M_lin[:, 1:], M_col[:, 1:]])
    X12 = np.column_stack([M_lin[:, i] * M_col[:, j] for i in range(1, r) for j in range(1, c)])
    Q, _ = np.linalg.qr(X1)
    Cmat = X12 - Q @ (Q.T @ X12)

    # Matriz de efeitos do desenho (Delta)
    Dinv = np.diag(np.where(p > 0, 1 / p, 0))
    denom = Cmat.T @ (Dinv / n) @ Cmat
    numr = Cmat.T @ Dinv @ V @ Dinv @ Cmat
    Delta = np.linalg.solve(denom, numr)
    tr = np.trace(Delta)
    tr2 = np.trace(Delta @ Delta)

    # 1ª ordem: qui² dividido pelo deff médio
    deff = tr / gl
    qui2_rs1 = qui2 / deff
    p_rs1 = stats.chi2.sf(qui2_rs1, gl)

    # 2ª ordem: estatística F (mesmo padrão do survey::svychisq do R)
    nu = len(upas) - upas[estrato].nunique()
    gl_num = tr ** 2 / tr2
    gl_den = gl_num * nu
    F = qui2 / tr
    p_rs2 = stats.f.sf(F, gl_num, gl_den)

    contrib = n * (P - E) ** 2 / E / deff
    resid_pearson = np.sign(P - E) * np.sqrt(contrib)

    # Resíduos ajustados pelo plano amostral (valor > 1,96 indica associação a 5%)
    resid_ajust = np.zeros((r, c))
    for i in range(r):
        for j in range(c):
            g = np.zeros(m)
            g[i * c + j] += 1
            g[i * c:(i + 1) * c] -= p_col[j]
            g[j::c] -= p_lin[i]
            resid_ajust[i, j] = (P[i, j] - E[i, j]) / np.sqrt(g @ V @ g)

    def como_df(a):
        return pd.DataFrame(a, index=pd.Index(linhas, name=var_linha), columns=pd.Index(colunas, name=var_coluna))

    return {'n': n, 'qui2': qui2, 'gl': gl, 'deff': deff,
            'qui2_rs1': qui2_rs1, 'p_rs1': p_rs1,
            'F': F, 'gl_num': gl_num, 'gl_den': gl_den, 'p_rs2': p_rs2,
            'contrib': como_df(contrib),
            'resid_pearson': como_df(resid_pearson),
            'resid_ajust': como_df(resid_ajust)}


def imprimir_rao_scott(res, titulo):
    print(titulo)
    print(f"Tamanho da amostra (n): {res['n']}")
    print(f"Estatística qui² de Pearson (proporções ponderadas, escala amostral): {res['qui2']:.2f}")
    print(f"Graus de liberdade: {res['gl']}")
    print(f"Efeito do desenho médio (deff): {res['deff']:.3f}")
    print(f"Qui² Rao-Scott (1ª ordem): {res['qui2_rs1']:.2f} | p-valor: {res['p_rs1']:.4g}")
    print(f"F Rao-Scott (2ª ordem): {res['F']:.2f} | gl: ({res['gl_num']:.2f}; {res['gl_den']:.2f}) | p-valor: {res['p_rs2']:.4g}")

#%% Download da base (inclui peso V1028 e variáveis do plano amostral)
